{
  "name": "hush",
  "version": "0.1.0",
  "private": true,
  "description": "A generative sleep-sound mixer that runs entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0"
  }
}
